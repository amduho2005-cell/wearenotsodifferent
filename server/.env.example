# Copia este archivo como server/.env y rellena tus datos. server/.env no se sube a GitHub.
# Cadena de conexión de MongoDB Atlas (Clusters → Connect → Drivers), con tu usuario y contraseña.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.ls8crvb.mongodb.net/
# Base de datos que usa la app (ya creada en Cluster0 con los datos de ejemplo).
MONGODB_DB=wansd
# Puerto de la API en local (opcional).
# API_PORT=4000
# Opcional en local: si lo pones, las fotos se suben a Vercel Blob en lugar de a server/uploads/.
# En Vercel se añade solo al conectar un almacén de Blob (público) al proyecto de la API.
# BLOB_READ_WRITE_TOKEN=
